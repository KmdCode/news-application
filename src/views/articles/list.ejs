<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Articles</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container mt-4">
    <h1>Articles</h1>
    <a href="/articles/create" class="btn btn-success mb-3">Create Article</a>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Tags</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% articles.forEach((article, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= article.title %></td>
            <td><%= article.tags.join(', ') %></td>
            <td>
              <a href="/articles/edit/<%= article.id %>" class="btn btn-primary btn-sm">Edit</a>
              <form action="/articles/delete/<%= article.id %>" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
